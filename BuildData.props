<Project>
  <PropertyGroup>
    <!--
    IMPORTANT: Don't make use of special (ie: spaces / : ; , \ < > ?) (periods "." are good) and non-english characters in the ModName.
    -->
    <ModName>NoMoreRubberbanding</ModName>
    <RepositoryURL>https://github.com/lonelyicer/NoMoreRubberbanding</RepositoryURL>

    <!--
    Enables the use of Publicized assemblies in place of the standard Barotrauma assemblies, allowing access to members that were
    previously restricted by access modifiers. Enable only if you know what you are doing.
    -->
    <UsePublicizedAssemblies>true</UsePublicizedAssemblies>

    <Company>lonelyicer</Company>
    <Authors>lonelyicer</Authors>

    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>

    <!-- Default deployment folder so a fresh clone builds without creating UserBuildData.props. -->
    <ModDeployDir Condition="'$(ModDeployDir)' == ''">$(MSBuildThisFileDirectory)dist</ModDeployDir>
  </PropertyGroup>

  <Import Project="UserBuildData.props" Condition="Exists('UserBuildData.props')" />
</Project>
